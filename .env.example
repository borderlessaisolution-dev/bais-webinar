# LiveKit Cloud（https://cloud.livekit.io → Project → Settings → Keys）
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Supabase（Project Settings → API）
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 老师控制台密码（/host/lansidai 进入时要输入）
HOST_KEY=

# 随便一串长的英文数字，用来签学员凭证
APP_SECRET=

# ---- 第 2 阶段：付款（Stripe）----
# Stripe → Developers → API keys → Secret key（sk_live_... / 测试用 sk_test_...）
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → 你的 endpoint → Signing secret（whsec_...）
STRIPE_WEBHOOK_SECRET=
# 网站正式网址（付款完成后跳回来用），例如 https://webinar.baismy.com
NEXT_PUBLIC_SITE_URL=
# 还没接 Stripe 想先测流程：设 PAYMENT_PROVIDER=mock（会出现「测试付款页」，不会真的扣钱）
PAYMENT_PROVIDER=
